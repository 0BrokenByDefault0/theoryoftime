# expo-router depends on web-only UI packages (vaul -> @radix-ui/*) whose peer
# ranges resolve react-dom@19.2.8, which in turn demands react@^19.2.8. Expo
# SDK 57 pins react@19.2.3, so npm's strict peer resolution deadlocks.
#
# None of that code is reachable on iOS or Android — it is the web bundle only.
# Relaxing peer resolution is the supported fix for this class of Expo
# conflict, and is what the verified iOS bundle was built with.
legacy-peer-deps=true

# Suppress the post-install audit summary.
#
# This is not complacency. Every advisory this project reports is in build
# tooling — metro, postcss, @react-native-community/cli, xcode — which runs on
# the developer's machine and is never bundled into the app. The app itself
# makes no network requests, has no server, and stores nothing remotely.
#
# The summary exists only to advertise `npm audit fix --force`, and running
# that here downgrades Expo 57 -> 53 and React Native 0.86 -> 0.72, breaking
# the project completely. Removing the suggestion is safer than leaving it.
#
# To audit deliberately: `npm audit` still works when you type it yourself.
audit=false

# The funding footer is pure noise on a project this size.
fund=false
